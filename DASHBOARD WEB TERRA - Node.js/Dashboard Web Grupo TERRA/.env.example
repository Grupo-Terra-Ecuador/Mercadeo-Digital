# Copia este archivo a .env.local (NO se sube a git) y completa tus valores.

# Client ID de OAuth 2.0 (tipo "Aplicación web") desde Google Cloud Console.
# Requiere las APIs "Google Analytics Data API", "Google Analytics Admin API"
# y "Search Console API" habilitadas, y este mismo origen agregado en
# "Authorized JavaScript origins" del Client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# URL del Cloudflare Worker que actua como proxy hacia la API de Claude (carpeta worker/).
# Sin barra final. Ejemplo: https://terra-dashboard-ai.tu-subdominio.workers.dev
NEXT_PUBLIC_AI_WORKER_URL=
