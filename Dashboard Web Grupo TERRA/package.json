{
  "name": "dashboard-grupo-terra",
  "version": "0.1.0",
  "description": "Dashboard técnico de analítica web (GA4 + Search Console) para Grupo TERRA. Procesa CSV o se conecta directamente a las APIs de Google.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.export-engine.config.js",
