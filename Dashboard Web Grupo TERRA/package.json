    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "vite": "^8.2.1",
    "vitest": "^2.1.5"
  }
}
